(function(){const c=document.getElementById('bg-canvas'),ctx=c.getContext('2d');let W,H;function rs(){W=c.width=window.innerWidth;H=c.height=window.innerHeight;}rs();window.addEventListener('resize',rs);const orbs=Array.from({length:8},()=>({x:Math.random()*W,y:Math.random()*H,r:180+Math.random()*200,vx:(Math.random()-.5)*.3,vy:(Math.random()-.5)*.3,a:.03+Math.random()*.04,p:Math.random()*Math.PI*2}));const G=55;let t=0;function draw(){ctx.clearRect(0,0,W,H);t+=.008;const sY=window.scrollY*.2;ctx.lineWidth=1;for(let x=0;x<W;x+=G){const a=0.06+0.04*Math.sin(t+x*.01);ctx.strokeStyle='rgba(0,212,200,'+a+')';ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,H);ctx.stroke();}for(let y=-G;y<H+G;y+=G){const w=Math.sin(t*1.5+y*.015)*14,a=0.05+0.03*Math.sin(t+y*.02);ctx.strokeStyle='rgba(0,212,200,'+a+')';ctx.beginPath();ctx.moveTo(0,y+(sY%G)+w);ctx.lineTo(W,y+(sY%G)-w);ctx.stroke();}orbs.forEach(o=>{o.x+=o.vx;o.y+=o.vy;o.p+=.012;if(o.x<-o.r)o.x=W+o.r;if(o.x>W+o.r)o.x=-o.r;if(o.y<-o.r)o.y=H+o.r;if(o.y>H+o.r)o.y=-o.r;const p=o.a*(.5+.5*Math.sin(o.p)),g=ctx.createRadialGradient(o.x,o.y,0,o.x,o.y,o.r);g.addColorStop(0,'rgba(0,212,200,'+(p*2.5)+')');g.addColorStop(.4,'rgba(0,212,200,'+(p*1.2)+')');g.addColorStop(1,'rgba(0,212,200,0)');ctx.beginPath();ctx.arc(o.x,o.y,o.r,0,Math.PI*2);ctx.fillStyle=g;ctx.fill();});[[0,0],[W,0],[0,H],[W,H]].forEach(([cx,cy],i)=>{const r=(t*60+i*80)%300,a=Math.max(0,.12*(1-r/300));ctx.beginPath();ctx.arc(cx,cy,r,0,Math.PI*2);ctx.strokeStyle='rgba(0,212,200,'+a+')';ctx.lineWidth=1.5;ctx.stroke();});requestAnimationFrame(draw);}draw();})();
const io=new IntersectionObserver(e=>{e.forEach(x=>{if(x.isIntersecting){x.target.classList.add('visible');io.unobserve(x.target);}});},{threshold:.12});
document.querySelectorAll('.reveal,.reveal-scale').forEach(el=>io.observe(el));
(function(){const cio=new IntersectionObserver(e=>{e.forEach(x=>{if(x.isIntersecting&&!x.target.dataset.done){x.target.dataset.done='1';const tg=parseInt(x.target.dataset.target),sf=x.target.dataset.suffix||'',dur=1600,s=performance.now();(function tick(n){const p=Math.min((n-s)/dur,1),e2=1-Math.pow(1-p,3);x.target.textContent=Math.floor(e2*tg)+sf;if(p<1)requestAnimationFrame(tick);else x.target.textContent=tg+sf;})(performance.now());}});},{threshold:.1});document.querySelectorAll('.stat-val[data-target]').forEach(el=>cio.observe(el));})();
document.querySelectorAll('.faq-q').forEach(btn=>{btn.addEventListener('click',function(){const item=this.parentElement,was=item.classList.contains('open');document.querySelectorAll('.faq-item-box').forEach(i=>i.classList.remove('open'));if(!was)item.classList.add('open');});});
window.addEventListener('mousemove',e=>{const g=document.querySelector('.hero-glow');if(!g)return;const x=(e.clientX/window.innerWidth-.5)*30,y=(e.clientY/window.innerHeight-.5)*30;g.style.transform='translate('+x+'px,'+y+'px)';});
document.querySelectorAll('.loc-pill').forEach(a=>{if(a.href===location.href)a.classList.add('active');});
</script>
