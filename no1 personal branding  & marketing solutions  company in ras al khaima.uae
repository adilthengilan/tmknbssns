<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,900;1,400;1,700&family=Montserrat:wght@300;400;500;600;700&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
:root{--teal:#00d4a8;--teal-dim:rgba(0,212,168,0.15);--bg:#000;--card-bg:#0F1116;--text:#fff;--muted:rgba(255,255,255,0.55);--border:rgba(0,212,168,0.2);}
html{scroll-behavior:smooth;}
body{font-family:'Montserrat',sans-serif;background:var(--bg);color:var(--text);overflow-x:hidden;}
.navbar{position:fixed;top:0;left:0;right:0;z-index:1000;padding:0 48px;height:72px;display:flex;align-items:center;justify-content:space-between;background:rgba(0,0,0,0.75);backdrop-filter:blur(24px);border-bottom:1px solid rgba(0,212,168,0.12);transition:background 0.4s,box-shadow 0.4s;}
.navbar.scrolled{background:rgba(0,0,0,0.95);box-shadow:0 4px 30px rgba(0,0,0,0.5);}
.nav-logo a{display:flex;align-items:center;text-decoration:none;}
.nav-logo img{height:44px;width:124px;object-fit:contain;display:block;}
.nav-logo-text{font-family:'Playfair Display',serif;font-size:20px;font-weight:700;color:var(--teal);display:none;}
.nav-right{display:flex;align-items:center;gap:36px;}
.nav-menu{display:flex;gap:32px;list-style:none;align-items:center;}
.nav-link{color:rgba(255,255,255,0.72);text-decoration:none;font-size:13px;font-weight:500;letter-spacing:0.4px;transition:color 0.25s;position:relative;padding-bottom:2px;}
.nav-link::after{content:'';position:absolute;bottom:-2px;left:0;width:0;height:1.5px;background:var(--teal);transition:width 0.3s;}
.nav-link:hover,.nav-link.active{color:var(--teal);}.nav-link:hover::after,.nav-link.active::after{width:100%;}
.nav-buttons{display:flex;align-items:center;gap:10px;}
.nav-btn-outline{display:inline-flex;align-items:center;gap:7px;color:var(--teal);border:1.5px solid rgba(0,212,168,0.4);padding:9px 22px;border-radius:100px;font-size:12.5px;font-weight:600;text-decoration:none;transition:all 0.3s;white-space:nowrap;}
.nav-btn-outline:hover{background:var(--teal-dim);border-color:var(--teal);}
.nav-cta{display:inline-flex;align-items:center;gap:7px;background:var(--teal);color:#000;padding:10px 24px;border-radius:100px;font-size:12.5px;font-weight:700;text-decoration:none;transition:all 0.3s;white-space:nowrap;}
.nav-cta:hover{background:#00ffc8;transform:translateY(-1px);box-shadow:0 6px 20px rgba(0,212,168,0.35);}
.hamburger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:6px;background:none;border:none;z-index:1100;}
.hamburger span{display:block;width:24px;height:2px;background:#fff;border-radius:2px;transition:all 0.3s;}
.hamburger.open span:nth-child(1){transform:translateY(7px) rotate(45deg);}
.hamburger.open span:nth-child(2){opacity:0;}
.hamburger.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg);}
.mobile-menu{display:none;position:fixed;top:72px;left:0;right:0;background:rgba(0,0,0,0.97);border-bottom:1px solid rgba(0,212,168,0.15);padding:24px 32px 32px;flex-direction:column;gap:4px;z-index:999;transform:translateY(-10px);opacity:0;pointer-events:none;transition:all 0.3s;}
.mobile-menu.open{opacity:1;transform:translateY(0);pointer-events:all;display:flex;}
.mobile-link{color:rgba(255,255,255,0.8);text-decoration:none;font-size:15px;font-weight:500;padding:14px 0;border-bottom:1px solid rgba(255,255,255,0.06);transition:color 0.2s;}
.mobile-link:hover{color:var(--teal);}
.mobile-menu-btns{display:flex;flex-direction:column;gap:10px;margin-top:20px;}
.mobile-cta{background:var(--teal);color:#000;text-align:center;padding:13px;border-radius:100px;font-weight:700;font-size:13px;text-decoration:none;}
.mobile-cta-outline{border:1.5px solid rgba(0,212,168,0.4);color:var(--teal);text-align:center;padding:12px;border-radius:100px;font-weight:600;font-size:13px;text-decoration:none;}
.hero{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative;overflow:hidden;padding:120px 40px 80px;text-align:center;}
.hero-bg{position:absolute;inset:0;background:radial-gradient(ellipse 80% 60% at 50% 0%,rgba(0,212,168,0.12) 0%,transparent 70%),radial-gradient(ellipse 40% 40% at 80% 80%,rgba(0,212,168,0.06) 0%,transparent 60%);pointer-events:none;}
.hero-badge{display:inline-flex;align-items:center;gap:8px;background:rgba(0,212,168,0.1);border:1px solid rgba(0,212,168,0.3);border-radius:100px;padding:8px 18px;font-size:12px;font-weight:600;color:var(--teal);letter-spacing:2px;text-transform:uppercase;margin-bottom:32px;animation:fadeUp 0.6s ease both;}
.hero-badge::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--teal);animation:pulse 2s infinite;}
.hero h1{font-family:'Playfair Display',serif;font-weight:900;font-size:clamp(34px,5.2vw,66px);line-height:1.12;margin-bottom:28px;animation:fadeUp 0.6s 0.1s ease both;}
.hero h1 .line-1,.hero h1 .line-2{display:block;}
.hero h1 .line-teal{display:block;font-style:italic;background:linear-gradient(90deg,var(--teal) 0%,#fff 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;background-size:200%;animation:shimmer 4s ease-in-out infinite,fadeUp 0.6s 0.15s ease both;}
.hero-sub{font-family:'DM Sans',sans-serif;font-size:16px;font-weight:300;line-height:1.8;color:var(--muted);max-width:640px;margin:0 auto 50px;animation:fadeUp 0.6s 0.2s ease both;}
.hero-cta{display:flex;align-items:center;gap:20px;flex-wrap:wrap;justify-content:center;animation:fadeUp 0.6s 0.3s ease both;}
.btn-primary{display:inline-flex;align-items:center;gap:10px;background:var(--teal);color:#000;padding:16px 32px;border-radius:6px;font-size:14px;font-weight:700;letter-spacing:0.5px;text-decoration:none;transition:all 0.3s;text-transform:uppercase;}
.btn-primary:hover{background:#00ffc8;transform:translateY(-2px);box-shadow:0 12px 30px rgba(0,212,168,0.35);}
.btn-secondary{display:inline-flex;align-items:center;gap:10px;color:var(--teal);border:1px solid var(--border);padding:16px 32px;border-radius:6px;font-size:14px;font-weight:600;text-decoration:none;transition:all 0.3s;text-transform:uppercase;}
.btn-secondary:hover{background:var(--teal-dim);border-color:var(--teal);}
.cta-divider{color:var(--muted);font-size:13px;}
.hero-stats{display:flex;gap:60px;justify-content:center;margin-top:70px;flex-wrap:wrap;animation:fadeUp 0.6s 0.4s ease both;}
.stat-item{text-align:center;}
.stat-num{font-family:'Playfair Display',serif;font-size:40px;font-weight:700;color:var(--teal);display:block;}
.stat-label{font-size:12px;color:var(--muted);font-weight:500;letter-spacing:1px;text-transform:uppercase;margin-top:4px;}
.stat-divider{width:1px;background:rgba(0,212,168,0.2);align-self:stretch;}
section{padding:100px 40px;}
.section-label{color:var(--teal);font-size:12px;font-weight:600;letter-spacing:4px;text-transform:uppercase;margin-bottom:14px;display:block;}
.section-title{font-family:'Playfair Display',serif;font-size:clamp(32px,4vw,52px);font-weight:700;line-height:1.2;margin-bottom:16px;}
.section-title .highlight{color:var(--teal);}
.section-sub{font-size:15px;font-weight:300;color:var(--muted);max-width:560px;line-height:1.8;}
.services-section{background:#000;}
.services-header{text-align:center;margin-bottom:60px;}
.services-header .section-sub{margin:0 auto;}
.services-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:30px;max-width:1300px;margin:0 auto;}
.service-card{background:var(--card-bg);border-radius:20px;padding:40px 35px;border-left:5px solid var(--teal);position:relative;overflow:hidden;transition:all 0.4s cubic-bezier(0.4,0,0.2,1);}
.service-card::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(0,212,168,0.12) 0%,rgba(0,212,168,0.04) 50%,transparent 100%);opacity:0;transition:opacity 0.4s;}
.service-card:hover{transform:translateY(-10px);box-shadow:0 24px 48px rgba(0,212,168,0.2);}
.service-card:hover::before{opacity:1;}
.service-card>*{position:relative;z-index:1;}
.card-icon{width:64px;height:64px;border-radius:50%;background:var(--teal-dim);border:2px solid var(--border);display:flex;align-items:center;justify-content:center;margin-bottom:24px;transition:all 0.4s;font-size:26px;}
.service-card:hover .card-icon{transform:scale(1.1) rotate(5deg);background:rgba(0,212,168,0.22);border-color:rgba(0,212,168,0.5);}
.service-card h3{font-family:'Playfair Display',serif;font-size:22px;font-weight:600;margin-bottom:14px;}
.service-card p{font-size:13.5px;font-weight:300;color:var(--muted);line-height:1.75;margin-bottom:22px;}
.card-tags{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:22px;}
.tag{background:rgba(0,212,168,0.08);border:1px solid rgba(0,212,168,0.2);color:var(--teal);border-radius:100px;padding:4px 12px;font-size:11px;font-weight:600;letter-spacing:0.5px;}
.card-link{display:inline-flex;align-items:center;color:var(--teal);text-decoration:none;font-size:12.5px;font-weight:700;letter-spacing:1px;text-transform:uppercase;transition:all 0.3s;gap:6px;border-bottom:1px solid transparent;padding-bottom:2px;}
.card-link:hover{color:#00ffc8;border-bottom-color:#00ffc8;gap:10px;}
.content-section{background:#060608;}
.content-inner{max-width:1100px;margin:0 auto;}
.content-grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:50px;}
.content-card{background:var(--card-bg);border-radius:16px;padding:32px 28px;border-top:3px solid var(--teal);transition:transform 0.3s,box-shadow 0.3s;}
.content-card:hover{transform:translateY(-6px);box-shadow:0 20px 40px rgba(0,212,168,0.15);}
.content-card-icon{font-size:28px;margin-bottom:16px;}
.content-card h4{font-family:'Playfair Display',serif;font-size:18px;font-weight:600;margin-bottom:10px;}
.content-card p{font-size:13px;font-weight:300;color:var(--muted);line-height:1.75;}
.two-col-section{background:#000;}
.two-col-inner{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:start;}
.two-col-text p{font-family:'DM Sans',sans-serif;font-size:14.5px;font-weight:300;color:var(--muted);line-height:1.9;margin-bottom:1.2rem;}
.two-col-text p strong{color:#fff;font-weight:600;}
.checklist{display:flex;flex-direction:column;gap:14px;margin-top:12px;}
.check-item{display:flex;align-items:flex-start;gap:12px;padding:16px 18px;background:var(--card-bg);border-radius:10px;border:1px solid rgba(0,212,168,0.15);transition:border-color 0.25s,transform 0.25s;}
.check-item:hover{border-color:rgba(0,212,168,0.35);transform:translateX(4px);}
.check-dot{width:8px;height:8px;border-radius:50%;background:var(--teal);flex-shrink:0;margin-top:5px;}
.check-text strong{display:block;font-size:13.5px;font-weight:600;color:#fff;margin-bottom:3px;}
.check-text span{font-size:12.5px;color:var(--muted);font-weight:300;line-height:1.6;}
.process-section{background:#060608;}
.process-container{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;}
.process-steps{display:flex;flex-direction:column;gap:0;}
.step{display:flex;gap:24px;padding:28px 0;border-bottom:1px solid rgba(255,255,255,0.06);transition:all 0.3s;}
.step:last-child{border-bottom:none;}
.step:hover .step-num{color:#000;background:var(--teal);}
.step-num{font-family:'Playfair Display',serif;font-size:18px;font-weight:700;color:var(--teal);width:44px;height:44px;border-radius:50%;border:2px solid var(--border);display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all 0.3s;}
.step-content h4{font-family:'Playfair Display',serif;font-size:18px;font-weight:600;margin-bottom:6px;}
.step-content p{font-size:13px;color:var(--muted);font-weight:300;line-height:1.7;}
.process-card{background:var(--card-bg);border-radius:20px;padding:40px;border:1px solid var(--border);}
.process-card h3{font-family:'Playfair Display',serif;font-size:24px;margin-bottom:8px;}
.tech-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:20px;}
.tech-item{background:rgba(0,212,168,0.06);border:1px solid rgba(0,212,168,0.15);border-radius:8px;padding:12px 14px;}
.tech-label{font-size:10px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:var(--teal);margin-bottom:4px;}
.tech-val{font-size:13px;font-weight:500;color:#fff;}
.geo-section{background:#000;padding:100px 40px;}
.geo-inner{max-width:1000px;margin:0 auto;}
.geo-intro{font-family:'DM Sans',sans-serif;font-size:15px;font-weight:300;color:var(--muted);line-height:2;margin-bottom:2rem;}
.geo-intro strong{color:#fff;font-weight:600;}
.geo-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:40px;}
.geo-card{background:var(--card-bg);border-radius:14px;padding:28px 24px;border-left:3px solid var(--teal);}
.geo-card h4{font-family:'Playfair Display',serif;font-size:17px;font-weight:600;margin-bottom:10px;color:#fff;}
.geo-card p{font-size:13px;color:var(--muted);line-height:1.75;font-weight:300;}

/* GEO Rich Content Section */
.geo-rich-section{background:#060608;padding:100px 40px;}
.geo-rich-inner{max-width:1000px;margin:0 auto;}
.geo-rich-text{font-family:'DM Sans',sans-serif;font-size:15px;font-weight:300;color:var(--muted);line-height:2;margin-bottom:1.5rem;}
.geo-rich-text strong{color:#fff;font-weight:600;}
.geo-rich-text a{color:var(--teal);text-decoration:none;}
.geo-qa-list{display:flex;flex-direction:column;gap:28px;margin-top:40px;}
.geo-qa-item{background:var(--card-bg);border-radius:14px;padding:28px 30px;border-left:3px solid var(--teal);}
.geo-qa-item h4{font-family:'Playfair Display',serif;font-size:17px;font-weight:600;color:#fff;margin-bottom:10px;}
.geo-qa-item p{font-size:13.5px;color:var(--muted);line-height:1.8;font-weight:300;}

.faq-section{background:#060608;position:relative;overflow:hidden;}
.faq-section::before{content:'';position:absolute;bottom:-100px;right:-100px;width:600px;height:600px;background:radial-gradient(circle,rgba(0,212,168,0.05) 0%,transparent 70%);pointer-events:none;}
.faq-container{max-width:900px;margin:0 auto;position:relative;z-index:1;}
.faq-header{text-align:center;margin-bottom:60px;}
.faq-header .section-sub{margin:0 auto;}
.faq-list{display:flex;flex-direction:column;gap:0;}
.faq-item{border-bottom:1px solid rgba(0,212,168,0.12);overflow:hidden;}
.faq-item:first-child{border-top:1px solid rgba(0,212,168,0.12);}
.faq-question{width:100%;background:none;border:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:20px;padding:28px 0;text-align:left;transition:all 0.3s;}
.faq-question:hover .faq-q-text{color:var(--teal);}
.faq-q-text{font-family:'Playfair Display',serif;font-size:18px;font-weight:600;color:var(--text);line-height:1.4;transition:color 0.3s;flex:1;}
.faq-icon{width:36px;height:36px;border-radius:50%;border:1.5px solid rgba(0,212,168,0.3);display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all 0.4s cubic-bezier(0.4,0,0.2,1);background:transparent;}
.faq-icon svg{width:14px;height:14px;stroke:var(--teal);transition:transform 0.4s cubic-bezier(0.4,0,0.2,1);}
.faq-item.open .faq-icon{background:var(--teal);border-color:var(--teal);transform:rotate(180deg);}
.faq-item.open .faq-icon svg{stroke:#000;}
.faq-answer{max-height:0;overflow:hidden;transition:max-height 0.45s cubic-bezier(0.4,0,0.2,1);}
.faq-item.open .faq-answer{max-height:600px;}
.faq-answer-inner{padding:0 0 28px 0;}
.faq-answer-inner p{font-family:'DM Sans',sans-serif;font-size:14.5px;font-weight:300;color:var(--muted);line-height:1.85;}
.faq-answer-inner p+p{margin-top:12px;}
.cta-section{background:linear-gradient(135deg,rgba(0,212,168,0.1) 0%,rgba(0,212,168,0.03) 50%,transparent 100%);border-top:1px solid rgba(0,212,168,0.15);text-align:center;padding:100px 40px;}
.cta-section h2{font-family:'Playfair Display',serif;font-size:clamp(36px,5vw,62px);font-weight:900;line-height:1.15;margin-bottom:20px;}
.cta-section h2 em{font-style:italic;color:var(--teal);}
.cta-section p{color:var(--muted);font-size:15px;font-weight:300;max-width:500px;margin:0 auto 40px;line-height:1.8;}
.cta-btns{display:flex;gap:20px;justify-content:center;flex-wrap:wrap;}
footer{background:#000;border-top:1px solid rgba(0,212,168,0.1);padding:60px 40px 30px;}
.footer-inner{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:50px;padding-bottom:40px;border-bottom:1px solid rgba(255,255,255,0.06);}
.footer-brand img{height:50px;width:140px;object-fit:contain;margin-bottom:16px;display:block;}
.footer-brand p{font-size:13px;color:var(--muted);line-height:1.8;font-weight:300;margin-bottom:16px;}
.footer-contact p{font-size:12.5px;color:var(--muted);margin-bottom:8px;font-weight:300;}
.footer-col h5{font-size:12px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--teal);margin-bottom:20px;}
.footer-col ul{list-style:none;}
.footer-col li{margin-bottom:10px;}
.footer-col a{color:var(--muted);text-decoration:none;font-size:13px;font-weight:300;transition:color 0.3s;}
.footer-col a:hover{color:#fff;}
.footer-bottom{max-width:1200px;margin:24px auto 0;display:flex;justify-content:space-between;align-items:center;font-size:12px;color:rgba(255,255,255,0.3);}
@keyframes fadeUp{from{opacity:0;transform:translateY(24px);}to{opacity:1;transform:translateY(0);}}
@keyframes shimmer{0%,100%{background-position:0% 50%;}50%{background-position:100% 50%;}}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1);}50%{opacity:0.5;transform:scale(0.7);}}
.reveal{opacity:0;transform:translateY(30px);transition:opacity 0.7s ease,transform 0.7s ease;}
.reveal.visible{opacity:1;transform:none;}
.reveal-delay-1{transition-delay:0.1s;}.reveal-delay-2{transition-delay:0.2s;}
@media(max-width:900px){.process-container,.two-col-inner,.geo-grid{grid-template-columns:1fr;gap:50px;}.footer-inner{grid-template-columns:1fr 1fr;}.nav-menu,.nav-buttons{display:none;}.hamburger{display:flex;}.content-grid-3{grid-template-columns:1fr 1fr;}}
@media(max-width:600px){section{padding:70px 20px;}.geo-section,.geo-rich-section{padding:70px 20px;}.navbar{padding:16px 20px;}.footer-inner{grid-template-columns:1fr;}.hero-stats{gap:30px;}.stat-divider{display:none;}.content-grid-3{grid-template-columns:1fr;}.faq-q-text{font-size:16px;}}
</style></head><body>

