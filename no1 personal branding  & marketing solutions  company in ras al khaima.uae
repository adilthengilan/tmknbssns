<!-- PROCESS -->
<section class="process-section">
  <div class="process-container">
    <div class="reveal reveal-delay-1">
      <span class="section-label">How We Build Your Brand</span>
      <h2 class="section-title">Our <span class="highlight">6-Week Brand Launch</span></h2>
      <p style="color:var(--muted);font-size:14px;line-height:1.8;margin-bottom:30px;">From your first conversation with our team to a fully launched, consistent personal brand — in six structured and efficient weeks, with ongoing monthly growth from day one.</p>
      <div class="process-steps">
        <div class="step">
          <div class="step-num">01</div>
          <div class="step-content">
            <h4>Brand Audit & Discovery</h4>
            <p>We review your current digital presence, identify positioning gaps, map your target audience within RAK and the UAE, and locate your biggest untapped visibility opportunities in your sector.</p>
          </div>
        </div>
        <div class="step">
          <div class="step-num">02</div>
          <div class="step-content">
            <h4>Strategy & Visual Identity</h4>
            <p>Your positioning statement, core messages, content pillars, platform strategy, and complete visual identity — all defined and approved before a single piece of content is published or shared.</p>
          </div>
        </div>
        <div class="step">
          <div class="step-num">03</div>
          <div class="step-content">
            <h4>Content Production & Launch</h4>
