<style>
:root{--gold:#07958E;--gold-light:#0ab8b0;--gold-dim:rgba(7,149,142,0.10);--gold-border:rgba(7,149,142,0.22);--ink:#0a0b09;--ink2:#0f1210;--ink3:#161b18;--ink4:#1e2622;--text:#d8d4cc;--muted:#8a9490;--white:#ffffff;--line:rgba(7,149,142,0.15);}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{background:var(--ink);color:var(--text);font-family:'DM Sans',sans-serif;font-size:16px;line-height:1.72;overflow-x:hidden;}
nav{position:sticky;top:0;z-index:200;background:rgba(10,11,9,0.94);backdrop-filter:blur(16px);border-bottom:1px solid var(--gold-border);padding:16px 6%;display:flex;justify-content:space-between;align-items:center;}
.nav-logo{font-family:'Cormorant Garamond',serif;font-size:1.55rem;font-weight:700;color:var(--gold);text-decoration:none;letter-spacing:1px;}
.nav-right{display:flex;align-items:center;gap:20px;}
.nav-tel{font-size:.78rem;font-weight:500;color:var(--muted);text-decoration:none;}
.nav-tel:hover{color:var(--gold);}
.nav-cta{background:var(--gold);color:var(--white);font-weight:600;font-size:.78rem;padding:9px 20px;border-radius:2px;text-decoration:none;letter-spacing:.5px;text-transform:uppercase;transition:background 0.2s;}
.nav-cta:hover{background:var(--gold-light);}
.hero{padding:110px 6% 90px;background:var(--ink2);position:relative;overflow:hidden;text-align:center;}
.hero::before{content:'';position:absolute;top:-200px;left:50%;transform:translateX(-50%);width:900px;height:700px;background:radial-gradient(ellipse at 50% 30%,rgba(7,149,142,0.07) 0%,transparent 65%);pointer-events:none;}
.hero::after{content:'';position:absolute;bottom:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,var(--gold-border),transparent);}
.eyebrow{display:inline-flex;align-items:center;gap:10px;font-size:.72rem;font-weight:600;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:28px;}
.eyebrow::before,.eyebrow::after{content:'';display:block;width:28px;height:1px;background:var(--gold);opacity:0.5;}
.hero h1{font-family:'Cormorant Garamond',serif;font-size:clamp(2.4rem,5.5vw,4.2rem);font-weight:700;line-height:1.1;color:var(--white);max-width:860px;margin:0 auto 28px;letter-spacing:-0.5px;}
.hero h1 em{color:var(--gold);font-style:normal;}
.hero .sub{font-size:1.05rem;color:var(--muted);max-width:620px;margin:0 auto 42px;font-weight:300;line-height:1.85;}
.hero-actions{display:flex;gap:14px;flex-wrap:wrap;justify-content:center;}
.btn-gold{background:var(--gold);color:var(--white);font-weight:600;font-size:.88rem;padding:14px 34px;border-radius:2px;text-decoration:none;text-transform:uppercase;letter-spacing:.6px;transition:background 0.2s;}
.btn-gold:hover{background:var(--gold-light);}
.btn-outline{border:1px solid var(--gold-border);color:var(--gold);font-weight:500;font-size:.88rem;padding:14px 34px;border-radius:2px;text-decoration:none;transition:background 0.2s,border-color 0.2s;}
.btn-outline:hover{background:var(--gold-dim);border-color:var(--gold);}
.trust-bar{background:var(--ink3);border-bottom:1px solid var(--line);padding:18px 6%;display:flex;gap:0;flex-wrap:wrap;align-items:stretch;justify-content:center;}
.trust-item{display:flex;align-items:center;gap:10px;padding:10px 28px;border-right:1px solid var(--line);font-size:.8rem;font-weight:500;color:var(--muted);letter-spacing:.3px;white-space:nowrap;}
.trust-item:last-child{border-right:none;}
.trust-item .mark{width:6px;height:6px;background:var(--gold);border-radius:50%;flex-shrink:0;}
section{padding:84px 6%;}
.section-inner{max-width:1120px;margin:0 auto;}
.section-alt{background:var(--ink2);}
.section-alt2{background:var(--ink3);}
.label-line{display:flex;align-items:center;gap:12px;font-size:.7rem;font-weight:600;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:16px;}
.label-line::after{content:'';flex:1;height:1px;background:var(--gold-border);max-width:60px;}
h2{font-family:'Cormorant Garamond',serif;font-size:clamp(2rem,3.5vw,2.8rem);font-weight:700;color:var(--white);line-height:1.18;margin-bottom:18px;letter-spacing:-0.3px;}
h2 em{color:var(--gold);font-style:normal;}
.lead{color:var(--muted);font-size:1rem;font-weight:300;max-width:620px;margin-bottom:40px;line-height:1.8;}
.aeo-entity-block{background:var(--ink4);border:1px solid var(--gold-border);padding:28px 32px;margin-bottom:40px;display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:20px;}
.aeo-entity-item .aeo-label{font-size:.68rem;font-weight:600;color:var(--gold);letter-spacing:2px;text-transform:uppercase;margin-bottom:4px;}
.aeo-entity-item .aeo-val{font-size:.92rem;color:var(--text);font-weight:500;}
.aeo-summary-box{background:var(--ink4);border:1px solid var(--gold-border);border-left:3px solid var(--gold);padding:28px 32px;margin:44px 0;}
.aeo-summary-box .aeo-summary-heading{font-size:.7rem;font-weight:700;color:var(--gold);letter-spacing:2.5px;text-transform:uppercase;margin-bottom:14px;}
.aeo-summary-box p{font-size:.92rem;color:var(--text);line-height:1.82;margin:0;}
.aeo-summary-box strong{color:var(--white);}
.overview-grid{display:grid;grid-template-columns:1fr 1fr;gap:2px;margin-top:44px;}
.overview-panel{background:var(--ink3);padding:38px 40px;}
.overview-panel.accent{background:var(--gold-dim);border:1px solid var(--gold-border);}
.overview-panel h3{font-family:'Cormorant Garamond',serif;font-size:1.3rem;font-weight:700;color:var(--white);margin-bottom:12px;}
.overview-panel p{font-size:.95rem;color:var(--muted);line-height:1.82;margin:0;}
.overview-panel.accent p{color:var(--text);}
.who-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:2px;margin-top:44px;}
.who-card{background:var(--ink3);padding:28px 30px;display:flex;align-items:flex-start;gap:18px;transition:background 0.2s;border:1px solid transparent;}
.who-card:hover{background:var(--ink4);border-color:var(--gold-border);}
.who-num{font-family:'Cormorant Garamond',serif;font-size:2.2rem;font-weight:700;color:var(--gold);opacity:0.35;line-height:1;flex-shrink:0;min-width:40px;}
.who-card h3{font-size:.92rem;font-weight:600;color:var(--white);margin-bottom:6px;}
.who-card p{font-size:.87rem;color:var(--muted);margin:0;line-height:1.7;}
.services-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:2px;margin-top:44px;}
.svc-card{background:var(--ink4);padding:26px 22px;text-align:center;border:1px solid transparent;transition:border-color 0.2s;}
.svc-card:hover{border-color:var(--gold-border);}
.svc-card .svc-icon{font-size:1.5rem;margin-bottom:12px;}
.svc-card h3{font-size:.88rem;font-weight:600;color:var(--white);margin-bottom:6px;}
.svc-card p{font-size:.8rem;color:var(--muted);margin:0;}
.steps-layout{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:start;margin-top:44px;}
.steps-list{display:flex;flex-direction:column;gap:0;}
.step{display:flex;gap:0;border-left:2px solid var(--line);padding:0 0 36px 32px;position:relative;}
.step:last-child{padding-bottom:0;}
.step::before{content:attr(data-n);position:absolute;left:-16px;top:0;width:30px;height:30px;background:var(--ink);border:1px solid var(--gold-border);color:var(--gold);font-size:.72rem;font-weight:700;display:flex;align-items:center;justify-content:center;border-radius:50%;letter-spacing:.5px;}
.step h3{font-size:.92rem;font-weight:600;color:var(--white);margin-bottom:6px;}
.step p{font-size:.87rem;color:var(--muted);margin:0;line-height:1.75;}
.steps-aside{background:var(--ink4);border:1px solid var(--gold-border);padding:36px 32px;position:sticky;top:90px;}
.aside-heading{font-family:'Cormorant Garamond',serif;font-size:1.5rem;font-weight:700;color:var(--white);margin-bottom:20px;line-height:1.25;}
.aside-stat{border-top:1px solid var(--line);padding:18px 0;}
.aside-stat:last-of-type{border-bottom:1px solid var(--line);margin-bottom:24px;}
.aside-stat .val{font-family:'Cormorant Garamond',serif;font-size:2.4rem;font-weight:700;color:var(--gold);line-height:1;}
.aside-stat .desc{font-size:.82rem;color:var(--muted);margin-top:4px;}
.why-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:2px;margin-top:44px;}
.why-card{background:var(--ink3);padding:32px 28px;border-bottom:2px solid transparent;transition:border-color 0.25s,background 0.25s;}
.why-card:hover{border-color:var(--gold);background:var(--ink4);}
.why-card .icon{width:36px;height:36px;border:1px solid var(--gold-border);display:flex;align-items:center;justify-content:center;font-size:1rem;margin-bottom:18px;border-radius:1px;}
.why-card h3{font-size:.92rem;font-weight:600;color:var(--white);margin-bottom:8px;}
.why-card p{font-size:.86rem;color:var(--muted);margin:0;line-height:1.72;}
.faq-list{margin-top:44px;display:flex;flex-direction:column;gap:2px;}
.faq-item{background:var(--ink3);overflow:hidden;}
.faq-q{width:100%;background:none;border:none;color:var(--text);font-family:'DM Sans',sans-serif;font-size:.95rem;font-weight:500;text-align:left;padding:22px 28px;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:16px;border-bottom:1px solid transparent;transition:color 0.2s;}
.faq-q:hover{color:var(--gold);}
.faq-item.open .faq-q{color:var(--gold);border-color:var(--line);}
.faq-plus{width:22px;height:22px;flex-shrink:0;border:1px solid var(--gold-border);display:flex;align-items:center;justify-content:center;font-size:1rem;color:var(--gold);line-height:1;transition:transform 0.3s,background 0.2s;border-radius:1px;}
.faq-item.open .faq-plus{transform:rotate(45deg);background:var(--gold-dim);}
.faq-a{max-height:0;overflow:hidden;transition:max-height 0.35s ease,padding 0.35s;padding:0 28px;font-size:.9rem;color:var(--muted);line-height:1.8;}
.faq-item.open .faq-a{max-height:480px;padding:0 28px 22px;}
.cta-section{background:var(--ink2);border-top:1px solid var(--gold-border);border-bottom:1px solid var(--gold-border);padding:90px 6%;text-align:center;position:relative;overflow:hidden;}
.cta-section::before{content:'';position:absolute;top:0;left:0;right:0;bottom:0;background:radial-gradient(ellipse at 50% 50%,rgba(7,149,142,0.05) 0%,transparent 65%);pointer-events:none;}
.cta-section h2{margin-bottom:16px;}
.cta-section .lead{margin:0 auto 40px;}
.contact-strip{margin-top:44px;display:flex;flex-wrap:wrap;gap:0;justify-content:center;border:1px solid var(--gold-border);}
.contact-cell{flex:1;min-width:220px;padding:22px 28px;border-right:1px solid var(--gold-border);display:flex;align-items:center;gap:14px;}
.contact-cell:last-child{border-right:none;}
.contact-cell .c-icon{width:34px;height:34px;flex-shrink:0;background:var(--gold-dim);border:1px solid var(--gold-border);display:flex;align-items:center;justify-content:center;font-size:.95rem;}
.contact-cell .c-label{font-size:.72rem;color:var(--muted);text-transform:uppercase;letter-spacing:1.5px;margin-bottom:2px;font-weight:500;}
.contact-cell .c-val{font-size:.9rem;color:var(--text);font-weight:500;}
.contact-cell a{color:var(--gold);text-decoration:none;}
.contact-cell a:hover{text-decoration:underline;}
footer{background:var(--ink);border-top:1px solid var(--line);padding:24px 6%;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;}
footer p{font-size:.8rem;color:var(--muted);margin:0;}
.footer-links{display:flex;gap:20px;}
footer a{font-size:.8rem;color:var(--muted);text-decoration:none;transition:color 0.2s;}
footer a:hover{color:var(--gold);}
.fade-up{opacity:0;transform:translateY(22px);animation:fu 0.7s ease forwards;}
@keyframes fu{to{opacity:1;transform:translateY(0);}}
.d1{animation-delay:.1s;}.d2{animation-delay:.22s;}.d3{animation-delay:.34s;}
@media(max-width:860px){.overview-grid{grid-template-columns:1fr;}.steps-layout{grid-template-columns:1fr;}.steps-aside{position:static;}.trust-item{padding:10px 16px;}}
@media(max-width:640px){.hero{padding:70px 5% 60px;}section{padding:60px 5%;}nav{padding:14px 5;}.nav-tel{display:none;}.contact-cell{flex:100%;border-right:none;border-bottom:1px solid var(--gold-border);}.contact-cell:last-child{border-bottom:none;}footer{flex-direction:column;text-align:center;}.trust-item{font-size:.73rem;}.aeo-entity-block{grid-template-columns:1fr 1fr;}}
</style>
</head>
