<script>
function faq(btn){const item=btn.parentElement;const isOpen=item.classList.contains('open');document.querySelectorAll('.faq-item').forEach(el=>el.classList.remove('open'));if(!isOpen)item.classList.add('open');}
const observer=new IntersectionObserver((entries)=>{entries.forEach(e=>{if(e.isIntersecting){e.target.style.opacity='1';e.target.style.transform='translateY(0)';observer.unobserve(e.target);}})},{threshold:0.1});
document.querySelectorAll('.who-card,.why-card,.svc-card,.step').forEach((el,i)=>{el.style.opacity='0';el.style.transform='translateY(18px)';el.style.transition=`opacity 0.55s ease ${i*0.06}s,transform 0.55s ease ${i*0.06}s`;observer.observe(el);});
</script>
